config device 'br_iptv'
	option name 'br-iptv'
	option type 'bridge'
	list ports 'lan5.85'
	list ports 'lan4.85'
	option stp '0'
	option igmp_snooping '0'

config device 'iptv_vlan85'
	option type '8021q'
	option ifname 'lan5'
	option vid '85'
	option name 'lan5.85'

config device 'stb_vlan85'
	option type '8021q'
	option ifname 'lan4'
	option vid '85'
	option name 'lan4.85'

config interface 'iptv_bridge'
	option device 'br-iptv'
	option proto 'static'
	option auto '1'
	option ipaddr '169.254.250.1'
	option netmask '255.255.255.255'
	option defaultroute '0'
	option peerdns '0'

config interface 'iptv_probe'
	option device 'br-iptv'
	option proto 'dhcp'
	option defaultroute '0'
	option peerdns '0'
	option delegate '0'
	option metric '900'

config device 'br_stb'
	option name 'br-stb'
	option type 'bridge'
	list ports 'lan4'
	option stp '0'

config interface 'stb'
	option device 'br-stb'
	option proto 'static'
	option ipaddr '192.168.32.1'
	option netmask '255.255.255.0'
	option defaultroute '0'
	option peerdns '0'
